{
  "name": "pagehub-documentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Panduan penggunaan PageHub \u2014 dokumentasi multi-bahasa (ID/EN/AR)",
  "scripts": {
    "dev": "vitepress dev",
    "build": "npm run check && vitepress build && npm run seo",
    "preview": "vitepress preview",
    "check": "node scripts/check-locales.mjs",
    "shots": "node scripts/list-shots.mjs",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "seo": "node scripts/check-seo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.86.0"
  }
}
